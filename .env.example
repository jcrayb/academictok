# Backend runtime config. Copy to `.env` (git-ignored) and fill in real values.

# Semantic Scholar API key (https://www.semanticscholar.org/product/api).
SEMANTIC_SCHOLAR_API_KEY=

# Ollama local LLM.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Context window. Ollama defaults to 4096, which truncates long PDF prompts and
# yields terse summaries; raise it so full-text prompts fit.
OLLAMA_NUM_CTX=8192
# Optional vision model for captioning extracted figures (e.g. gemma4:26b).
# Empty = disabled (qwen3.5:9b is text-only). Figures still display either way.
VISION_MODEL=
# Small/fast model for the live infinite-scroll discovery feed (e.g.
# qwen2.5:0.5b or qwen2.5:3b — pull it in Ollama first). Empty = use OLLAMA_MODEL.
# When set, those quick summaries are re-generated by OLLAMA_MODEL later via
# `python scripts/upgrade_summaries.py` (run it on a schedule / cron).
OLLAMA_FAST_MODEL=
DISCOVER_CONCURRENCY=4           # parallel Ollama requests per discovery batch
DISCOVER_BATCH=12               # papers fetched per infinite-scroll discovery call

# PDF ingestion: read open-access PDFs for richer summaries + figures.
# ENABLE_PDF_INGEST is the master switch; the two halves below toggle the slow
# parts independently. With both off, the PDF isn't downloaded (fastest).
ENABLE_PDF_INGEST=true
ENABLE_PDF_FULLTEXT=true        # feed full text to the detailed summary (grounds equations)
ENABLE_FIGURE_EXTRACT=true      # scan the PDF for figures (raster + vector)
ENABLE_VECTOR_FIGURES=true      # rasterize vector plots/diagrams to PNG (where most figures live)
MEDIA_DIR=./media               # where extracted figures are written
PDF_TEXT_CHAR_LIMIT=16000       # chars of PDF text fed to the LLM (~4k tokens)
MAX_FIGURES_PER_PAPER=4
MIN_FIGURE_DIM=256              # px; drops logos/glyphs
FIGURE_RENDER_DPI=150          # DPI for rasterizing vector figures

# SQLite database file path.
DATABASE_PATH=./academictok.db

# Path to the Firebase Admin service-account key (NOT the web client config).
FIREBASE_CRED_PATH=authkey.json

# Secret file listing admin emails (one per line) allowed into the dashboard.
ADMIN_EMAILS_PATH=admin_emails

# Comma-separated allowed CORS origins. Fails closed if empty (no cross-origin).
CORS_ORIGINS=http://localhost:4321

# Server settings.
PORT=8080
# Enable the Flask debugger ONLY for local development. Never "true" in prod.
DEBUG=false

# Frontend (Astro) config. Copy to `frontend/.env` (git-ignored).
#
# Every PUBLIC_* value is inlined into the browser bundle and is public by
# design — the Firebase *client* config is safe to expose. Access is controlled
# by Firebase Auth, not by hiding these values.
#
# Values below are the `academic-tok` project web config (see ../firebase_config).

PUBLIC_FIREBASE_API_KEY=AIzaSyA7QehvNodOpsvuS_vVUEN9HUbUxzpTuO0
PUBLIC_FIREBASE_AUTH_DOMAIN=academic-tok.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=academic-tok
PUBLIC_FIREBASE_STORAGE_BUCKET=academic-tok.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=952777401372
PUBLIC_FIREBASE_APP_ID=1:952777401372:web:114801fdfd877103632bd9
PUBLIC_FIREBASE_MEASUREMENT_ID=G-HEDQX0ZTP6

# Backend API base URL. Empty = same-origin.
PUBLIC_API_URL=http://localhost:8080

---
import "../styles/global.css";
const { title = "AcademicTok", useMath = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {useMath && <script id="MathJax-script" src="/mathjax/tex-chtml.js" is:inline />}
  </head>
  <body>
    <slot />
  </body>
</html>

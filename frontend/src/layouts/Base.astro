---
import "../styles/global.css";
const { title = "AcademicTok", useMath = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/icons/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="msapplication-TileColor" content="#da532c" />
    <meta name="theme-color" content="#ffffff" />
    {/* Applied before first paint so there's no flash of the wrong theme. */}
    <script is:inline>
      (function () {
        var backgrounds = {
          "very-dark": { mode: "dark", bg: "#141617", card: "#1d2021", border: "#282828", text: "#ebdbb2", muted: "#a89984" },
          "dark-hard": { mode: "dark", bg: "#1d2021", card: "#282828", border: "#3c3836", text: "#ebdbb2", muted: "#a89984" },
          dark: { mode: "dark", bg: "#282828", card: "#3c3836", border: "#504945", text: "#ebdbb2", muted: "#a89984" },
          "dark-soft": { mode: "dark", bg: "#32302f", card: "#45403d", border: "#5a524d", text: "#ebdbb2", muted: "#a89984" },
          "light-soft": { mode: "light", bg: "#f2e5bc", card: "#e5d3a8", border: "#d5c4a1", text: "#3c3836", muted: "#7c6f64" },
          light: { mode: "light", bg: "#fbf1c7", card: "#ebdbb2", border: "#d5c4a1", text: "#3c3836", muted: "#7c6f64" },
          "light-hard": { mode: "light", bg: "#f9f5d7", card: "#ebdbb2", border: "#d5c4a1", text: "#3c3836", muted: "#7c6f64" },
          "very-light": { mode: "light", bg: "#fffdf5", card: "#fbf8ef", border: "#e8e3d3", text: "#3c3836", muted: "#7c6f64" },
        };
        var accents = {
          red: { dark: "#fb4934", light: "#cc241d" },
          orange: { dark: "#fe8019", light: "#d65d0e" },
          yellow: { dark: "#fabd2f", light: "#d79921" },
          green: { dark: "#b8bb26", light: "#98971a" },
          aqua: { dark: "#8ec07c", light: "#689d6a" },
          blue: { dark: "#83a598", light: "#458588" },
          purple: { dark: "#d3869b", light: "#b16286" },
        };
        var oldMap = {
          "gruvbox-dark": "dark",
          "gruvbox-dark-soft": "dark-soft",
          "gruvbox-dark-hard": "dark-hard",
          "gruvbox-light": "light",
          "gruvbox-light-soft": "light-soft",
          "gruvbox-light-hard": "light-hard",
          light: "light",
          dark: "dark",
        };
        var bgId = localStorage.getItem("theme-bg");
        if (!backgrounds[bgId]) {
          var old = localStorage.getItem("theme");
          bgId = (old && oldMap[old]) || "dark";
        }
        var accentId = localStorage.getItem("theme-accent");
        if (!accents[accentId]) accentId = "orange";

        var bg = backgrounds[bgId];
        var accent = accents[accentId];
        var ok = bg.mode === "dark" ? "#b8bb26" : "#79740e";
        var bad = bg.mode === "dark" ? "#fb4934" : "#9d0006";
        var style = document.documentElement.style;
        style.setProperty("--color-bg", bg.bg);
        style.setProperty("--color-card", bg.card);
        style.setProperty("--color-border", bg.border);
        style.setProperty("--color-text", bg.text);
        style.setProperty("--color-muted", bg.muted);
        style.setProperty("--color-accent", bg.mode === "dark" ? accent.dark : accent.light);
        style.setProperty("--color-ok", ok);
        style.setProperty("--color-bad", bad);
      })();
    </script>
    {useMath && <script id="MathJax-script" src="/mathjax/tex-chtml.js" is:inline />}
  </head>
  <body>
    <slot />
  </body>
</html>

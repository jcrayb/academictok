---
import Base from "../layouts/Base.astro";
import NavBar from "../components/NavBar.astro";
---

<Base title="Fields · AcademicTok">
  <NavBar />
  <main class="mx-auto max-w-[760px] p-4">
    <h1>Fields</h1>
    <div class="relative mb-4">
      <input
        id="search"
        type="search"
        placeholder="Search fields by keyword…"
        class="w-full rounded-lg border border-border bg-card px-3 py-2 pr-[6.5rem] text-[0.95rem] text-text outline-none focus:border-accent"
      />
      <select
        id="search-mode"
        aria-label="Search mode"
        class="absolute right-1 top-1/2 -translate-y-1/2 rounded-md border border-border bg-card px-2 py-1 text-[0.85rem] text-text outline-none focus:border-accent"
      >
        <option value="fields">Fields</option>
        <option value="papers">Papers</option>
      </select>
    </div>
    <p class="min-h-[1.2rem] text-accent" id="hint"></p>
    <div id="fields" class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-4"></div>
  </main>
</Base>

<script>
  import { $user, $loading } from "../stores/auth";
  import {
    getFields, getSubscriptions, getLikedIds, getSavedIds, searchPapers,
    subscribe, unsubscribe, type Field, type FeedItem,
  } from "../lib/api";
  import { createCard } from "../lib/card";
  import { promptLogin } from "../lib/loginPrompt";

  const FIELDS_GRID_CLASS = "grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-4";
  const PAPERS_LIST_CLASS = "flex flex-col gap-4";

  const grid = document.getElementById("fields")!;
  const hint = document.getElementById("hint")!;
  const search = document.getElementById("search") as HTMLInputElement;
  const modeSelect = document.getElementById("search-mode") as HTMLSelectElement;
  let subscribed = new Set<string>();
  let likedPaperIds = new Set<number>();
  let savedPaperIds = new Set<number>();
  let signedInHint = "";

  function mode(): "fields" | "papers" {
    return modeSelect.value === "papers" ? "papers" : "fields";
  }

  async function load() {
    subscribed = new Set();
    likedPaperIds = new Set();
    savedPaperIds = new Set();
    if ($user.get()) {
      try {
        const { subscriptions } = await getSubscriptions();
        subscribed = new Set(subscriptions.map((s) => s.slug));
        const { paper_ids: liked } = await getLikedIds();
        likedPaperIds = new Set(liked);
        const { paper_ids: saved } = await getSavedIds();
        savedPaperIds = new Set(saved);
      } catch (e) { console.error(e); }
    } else {
      signedInHint = "Sign in to subscribe to fields.";
      hint.textContent = signedInHint;
    }
    await runSearch();
  }

  async function runSearch() {
    const q = search.value.trim();
    if (mode() === "papers") {
      grid.className = PAPERS_LIST_CLASS;
      if (!q) {
        hint.textContent = signedInHint || "Type a paper title to search.";
        renderPapers([]);
        return;
      }
      const { items } = await searchPapers(q);
      hint.textContent = items.length === 0
        ? `No papers match "${q}".`
        : signedInHint;
      renderPapers(items);
      return;
    }
    grid.className = FIELDS_GRID_CLASS;
    const { fields } = await getFields(q || undefined);
    hint.textContent = q && fields.length === 0
      ? `No fields match "${q}".`
      : signedInHint;
    render(fields);
  }

  let debounceTimer: ReturnType<typeof setTimeout>;
  search.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(runSearch, 200);
  });

  modeSelect.addEventListener("change", () => {
    search.placeholder = mode() === "papers"
      ? "Search papers by title…"
      : "Search fields by keyword…";
    runSearch();
  });

  function renderPapers(items: FeedItem[]) {
    grid.innerHTML = "";
    for (const item of items) {
      grid.appendChild(createCard(item, {
        subscribedSlugs: subscribed,
        likedPaperIds,
        savedPaperIds,
        signedIn: () => !!$user.get(),
        onNeedLogin: () => promptLogin("Sign in to subscribe, like, or save papers."),
      }));
    }
  }

  /** Subscribed fields first (stable sort keeps each group's own order),
   * so a user's joined fields surface before browsing/searching the rest. */
  function bubbleSubscribed(fields: Field[]) {
    return [...fields].sort((a, b) => {
      const as = subscribed.has(a.slug) ? 0 : 1;
      const bs = subscribed.has(b.slug) ? 0 : 1;
      return as - bs;
    });
  }

  function render(fields: Field[]) {
    grid.innerHTML = "";
    for (const f of bubbleSubscribed(fields)) {
      const on = subscribed.has(f.slug);
      const href = `/r/${encodeURIComponent(f.slug)}`;
      const el = document.createElement("article");
      
      el.className =
        "group cursor-pointer rounded-xl border border-border bg-card p-4 " +
        "transition-colors duration-150 hover:border-accent";
      el.innerHTML = `
        <div class="flex items-baseline justify-between">
          <h2 class="m-0 text-[1.05rem]"><a class="text-text no-underline group-hover:text-accent" href="${href}">${f.name.split('-').map(word => word[0].toUpperCase() + word.slice(1)) .join(' ')}</a></h2>
          <span class="text-[0.8rem] text-muted">${f.paper_count} posts</span>
        </div>
        <p class="min-h-[3.6em] text-[0.9rem] leading-[1.4] text-muted">${f.description ?? ""}</p>
        <button class="sub ${on ? "" : "primary"}">${on ? "Subscribed ✓" : "Subscribe"}</button>`;
        
      // Whole card navigates to the field, except the subscribe button.
      el.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("button")) return;
        location.href = href;
      });

      const btn = el.querySelector(".sub") as HTMLButtonElement;
      btn.onclick = async () => {
        if (!$user.get()) { hint.textContent = "Sign in to subscribe to fields."; return; }
        btn.disabled = true;
        try {
          if (subscribed.has(f.slug)) { await unsubscribe(f.slug); subscribed.delete(f.slug); }
          else { await subscribe(f.slug); subscribed.add(f.slug); }
          const now = subscribed.has(f.slug);
          btn.textContent = now ? "Subscribed ✓" : "Subscribe";
          btn.classList.toggle("primary", !now);
        } catch (e) { console.error(e); }
        btn.disabled = false;
      };
      grid.appendChild(el);
    }
  }

  let booted = false;
  $loading.subscribe((l) => { if (!l && !booted) { booted = true; load(); } });
  $user.subscribe(() => { if (!$loading.get()) load(); });
</script>

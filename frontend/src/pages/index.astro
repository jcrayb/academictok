---
import Base from "../layouts/Base.astro";
import NavBar from "../components/NavBar.astro";
---

<Base title="AcademicTok">
  <NavBar />

  <main class="mx-auto max-w-[640px] p-4">
    <div class="mb-2 flex items-center justify-between gap-[0.6rem]">
      <div class="flex gap-[0.6rem]">
        <button id="mode-discover" class="primary">Discover</button>
        <button id="mode-subscribed">Subscribed</button>
      </div>
      <label class="flex items-center gap-[0.4rem] text-[0.85rem] text-muted">Sort
        <select id="sort" class="rounded-lg border border-border bg-bg p-1 text-text">
          <option value="random">Random</option>
          <option value="citation">Most cited</option>
          <option value="year">Newest</option>
        </select>
      </label>
    </div>
    <p id="hint" class="my-[0.2rem] min-h-[1.2rem] text-[0.9rem] text-accent"></p>
    <div id="feed" class="flex flex-col gap-4"></div>
    <div id="sentinel" class="h-px"></div>
    <p id="status" class="p-4 text-center text-muted"></p>
  </main>
</Base>

<script>
  import { $user, $loading } from "../stores/auth";
  import {
    getMixedFeed, getSubscribedFeed, getSubscriptions, getLikedIds, getSavedIds,
    type FeedItem, type MixedCursor, type FieldSort,
  } from "../lib/api";
  import { createCard, type CardCtx } from "../lib/card";
  import { promptLogin } from "../lib/loginPrompt";

  const feedEl = document.getElementById("feed")!;
  const statusEl = document.getElementById("status")!;
  const hintEl = document.getElementById("hint")!;
  const sentinel = document.getElementById("sentinel")!;
  const discoverBtn = document.getElementById("mode-discover") as HTMLButtonElement;
  const subBtn = document.getElementById("mode-subscribed") as HTMLButtonElement;
  const sortSel = document.getElementById("sort") as HTMLSelectElement;

  let mode: "discover" | "subscribed" = "discover";
  let loadingPage = false;
  let exhausted = false;
  let mixedCursor: MixedCursor = {};
  let subOffset = 0;
  let sort: FieldSort = "random";
  // A per-run seed keeps the random order stable across paginated requests.
  let seed = Math.floor(Math.random() * 1e9);
  let subscribedSlugs = new Set<string>();
  let likedPaperIds = new Set<number>();
  let savedPaperIds = new Set<number>();
  const seen = new Set<number>();

  const cardCtx: CardCtx = {
    subscribedSlugs,
    likedPaperIds,
    savedPaperIds,
    signedIn: () => !!$user.get(),
    onNeedLogin: () => promptLogin("Sign in to subscribe, like, or save papers."),
  };

  function reset() {
    feedEl.innerHTML = "";
    statusEl.textContent = "";
    loadingPage = false;
    exhausted = false;
    mixedCursor = {};
    subOffset = 0;
    seed = Math.floor(Math.random() * 1e9);
    seen.clear();
  }

  async function refreshSubscriptions() {
    subscribedSlugs.clear();
    likedPaperIds.clear();
    savedPaperIds.clear();
    if (!$user.get()) return;
    try {
      const { subscriptions } = await getSubscriptions();
      subscriptions.forEach((s) => subscribedSlugs.add(s.slug));
      const { paper_ids: liked } = await getLikedIds();
      liked.forEach((id) => likedPaperIds.add(id));
      const { paper_ids: saved } = await getSavedIds();
      saved.forEach((id) => savedPaperIds.add(id));
    } catch (e) { console.error(e); }
  }

  function appendItems(items: FeedItem[]) {
    let added = 0;
    for (const it of items) {
      if (seen.has(it.paper_id)) continue;
      seen.add(it.paper_id);
      feedEl.appendChild(createCard(it, cardCtx));
      added++;
    }
    return added;
  }

  async function loadMore() {
    if (loadingPage || exhausted) return;
    loadingPage = true;
    statusEl.textContent = "Loading…";
    try {
      if (mode === "subscribed") {
        const data = await getSubscribedFeed(subOffset, sort, seed);
        appendItems(data.items);
        subOffset = data.next_offset;
        if (!data.items.length) exhausted = true;
      } else {
        const data = await getMixedFeed(mixedCursor, sort, seed);
        appendItems(data.items);
        mixedCursor = {
          sub_offset: data.next_sub_offset,
          other_offset: data.next_other_offset,
        };
        if (data.exhausted || !data.items.length) exhausted = true;
      }
      statusEl.textContent = exhausted
        ? (feedEl.children.length ? "You're all caught up." : "Nothing here yet.")
        : "";
    } catch (e) {
      console.error(e);
      statusEl.textContent = "Failed to load feed.";
    }
    loadingPage = false;
  }

  async function switchMode(next: "discover" | "subscribed") {
    if (next === "subscribed" && !$user.get()) {
      hintEl.textContent = "Sign in to see your subscribed feed.";
      return;
    }
    mode = next;
    hintEl.textContent = "";
    discoverBtn.classList.toggle("primary", next === "discover");
    subBtn.classList.toggle("primary", next === "subscribed");
    reset();
    await loadMore();
  }

  discoverBtn.onclick = () => switchMode("discover");
  subBtn.onclick = () => switchMode("subscribed");
  sortSel.onchange = () => {
    sort = sortSel.value as FieldSort;
    reset();
    loadMore();
  };

  new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) loadMore();
  }, { rootMargin: "400px" }).observe(sentinel);

  // Boot once auth state resolves; reload when the user signs in/out.
  let booted = false;
  $loading.subscribe(async (loading) => {
    if (loading) return;
    await refreshSubscriptions();
    if (!booted) { booted = true; reset(); await loadMore(); }
  });
  $user.subscribe(async () => {
    if ($loading.get()) return;
    await refreshSubscriptions();
    await switchMode("discover");
  });
</script>
